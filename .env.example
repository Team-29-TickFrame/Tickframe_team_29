# Copy this file to .env; never commit real credentials.
# Database bootstrap values apply when the volume is first created.
# Password must be long and URL-safe because Compose embeds it in DATABASE_URL.
POSTGRES_DB=tickframe
POSTGRES_USER=tickframe
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Published service ports.
BACKEND_PORT=8000
FRONTEND_PORT=4173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Login session lifetime, 1-365 days.
TICKFRAME_AUTH_SESSION_DAYS=7
# Extra public frontend origins, comma-separated. Local origins are automatic.
TICKFRAME_CORS_ORIGINS=
# Accounts allowed to open and run Scripts, comma-separated. Empty denies all.
TICKFRAME_SCRIPT_RUNNER_EMAILS=
# Script concurrency, in-memory history size, and captured output per run.
TICKFRAME_SCRIPT_MAX_ACTIVE_RUNS=10
TICKFRAME_SCRIPT_MAX_STORED_RUNS=100
TICKFRAME_SCRIPT_MAX_OUTPUT_KB=64
# Data, ML, and quality job timeouts in seconds.
TICKFRAME_SCRIPT_DEFAULT_TIMEOUT_SECONDS=1800
TICKFRAME_SCRIPT_ML_TIMEOUT_SECONDS=7200
TICKFRAME_SCRIPT_QUALITY_TIMEOUT_SECONDS=600

# Set to 1 for API-only startup without exchange collectors.
TICKFRAME_DISABLE_COLLECTORS=0
# Host source and container target for the structured market catalog.
TICKFRAME_MARKETS_CONFIG_FILE=./backend/config/markets.yaml
TICKFRAME_MARKETS_CONFIG_PATH=/app/backend/config/markets.runtime.yaml
# Enabled IDs from the market catalog. Use all to enable every configured ID.
TICKFRAME_ENABLED_INSTRUMENTS=all
# Late-trade window and raw-trade retention.
TICKFRAME_ALLOWED_LATENESS_MS=2000
TICKFRAME_RAW_TRADE_RETENTION_HOURS=72

# Comma-separated endpoint overrides. Empty values use markets.yaml/defaults.
TICKFRAME_BINANCE_WS_URLS=
TICKFRAME_BYBIT_WS_URLS=
TICKFRAME_BINANCE_REST_URLS=
TICKFRAME_BYBIT_REST_URLS=

# Startup/reconnect history recovery. Windows accept h/d suffixes.
TICKFRAME_DISABLE_RECOVERY_BACKFILL=0
TICKFRAME_RECOVERY_BACKFILL_HOURS=72h
TICKFRAME_BINANCE_1S_BACKFILL_HOURS=24h
TICKFRAME_SECOND_REPAIR_HOURS=72h
# Stable-candle delay; accepts raw milliseconds or duration suffixes.
TICKFRAME_STABLE_CHART_DELAY_MS=2000

# Pattern detector threshold and optional artifact override.
TICKFRAME_PATTERN_CONFIDENCE_THRESHOLD=0.45
# Empty path uses the bundled per-timeframe artifacts.
TICKFRAME_PATTERN_MODEL_PATH=

# Graceful service shutdown.
TICKFRAME_SHUTDOWN_TIMEOUT=15s

# Prometheus collection frequency and local data retention.
PROMETHEUS_SCRAPE_INTERVAL=5s
PROMETHEUS_EVALUATION_INTERVAL=5s
PROMETHEUS_RETENTION_TIME=15d

# Grafana bootstrap credentials apply when its volume is first created.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-another-random-password
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ROLE=Viewer
GRAFANA_DEFAULT_THEME=light

# Standalone backend only; Compose builds this URL from POSTGRES_* above.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
